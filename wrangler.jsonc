{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glasfaser-test",
  "main": "cloud/worker.mjs",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none"},
  "d1_databases": [{"binding": "DB", "database_name": "glasfaser-test", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "cloud/migrations"}],
  "observability": {"enabled": false}
}
